{
  "name": "Monthmark Android (cloud)",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "containerEnv": { "ANDROID_HOME": "/home/vscode/android-sdk" },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/android-sdk/platform-tools:/home/vscode/android-sdk/cmdline-tools/latest/bin" },
  "postCreateCommand": "bash .devcontainer/setup-android.sh",
  "customizations": { "vscode": { "extensions": ["vscjava.vscode-java-pack"] } }
}
