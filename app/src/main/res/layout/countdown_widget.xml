<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_tile_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Monthmark"
                android:textColor="#101613" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="✨" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13" android:textSize="42sp"
                android:textColor="#101613" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_unit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="days to go" android:textSize="12sp" android:textColor="#344B40" android:maxLines="2" />
        </LinearLayout>
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fri, 27 Nov"
            android:textSize="11sp" android:textColor="#344B40" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
