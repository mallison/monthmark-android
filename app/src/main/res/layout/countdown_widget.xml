<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Monthmark" android:textColor="#EFF5EF" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="13" android:textSize="44sp" android:textColor="#BBF5CC" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_unit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="days to go" android:textSize="13sp" android:textColor="#B4C3B7" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Fri, 27 Nov" android:textSize="12sp" android:textColor="#B4C3B7" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
