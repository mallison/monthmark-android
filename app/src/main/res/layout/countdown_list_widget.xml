            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Days to a good thing" android:textColor="#101613" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/date_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fri, 27 Nov" android:textColor="#344B40" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/days_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="13d" android:textColor="#101613" android:textSize="26sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
